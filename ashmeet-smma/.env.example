# Supabase
NEXT_PUBLIC_SUPABASE_URL=                 # project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # public anon key (safe for the browser; RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=                # server only, bypasses RLS, never in the client bundle

# Auth (NextAuth)
AUTH_SECRET=                              # random 32+ chars: openssl rand -base64 32
GOOGLE_OAUTH_CLIENT_ID=                   # Google OAuth client, sign-in only
GOOGLE_OAUTH_CLIENT_SECRET=               # Google OAuth client secret

# Google service account for Drive uploads
GOOGLE_SERVICE_ACCOUNT_EMAIL=             # service account client_email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=       # private_key from the JSON, newlines escaped as \n, in double quotes
GOOGLE_SHARED_DRIVE_ID=                   # id of the Shared Drive the service account is a member of

# Backblaze B2 (cuts, voice notes, library) via S3-compatible API
B2_ENDPOINT=                              # e.g. https://s3.us-west-004.backblazeb2.com
B2_REGION=                                # e.g. us-west-004
B2_BUCKET=                                # private bucket name
B2_KEY_ID=                                # application key ID
B2_APPLICATION_KEY=                       # application key secret

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=             # npx web-push generate-vapid-keys (public)
VAPID_PRIVATE_KEY=                        # npx web-push generate-vapid-keys (private)
VAPID_SUBJECT=                            # mailto:you@example.com

# Platform
CREDENTIAL_ENCRYPTION_KEY=                # base64 of 32 bytes: openssl rand -base64 32
CRON_SECRET=                              # shared secret for cron endpoints: openssl rand -hex 32
TRANSCRIPTION_API_KEY=                    # voice-note transcription (Phase 6, optional until then)
NEXT_PUBLIC_APP_URL=                      # e.g. http://localhost:3000
